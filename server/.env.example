PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/mtm
# Local Vite development origin (comma-separate if adding others)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SMTP optional; without these, inquiries still save but no emails are sent
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-app-password
# SMTP_FROM=inquiries@your-domain.example
# INQUIRY_NOTIFY_TO=your-notification-address@example.com
